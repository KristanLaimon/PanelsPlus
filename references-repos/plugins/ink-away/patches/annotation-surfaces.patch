diff --git a/docs/annotation-surfaces.md b/docs/annotation-surfaces.md
new file mode 100644
index 0000000..8012bb4
--- /dev/null
+++ b/docs/annotation-surfaces.md
@@ -0,0 +1,54 @@
+# Document annotation surfaces, version 1
+
+Ink Away owns tools, ink operations, undo and sidecar persistence. An external
+fixed-page viewer can supply document geometry without either plugin replacing
+the other's methods. This interface contains no viewer-specific identifiers.
+
+A visible widget exposes `getAnnotationSurface()`. Ink Away searches the window
+stack from the top when annotation starts, stopping at an unrelated fullscreen
+widget. It accepts a surface only when `version == 1` and `document` is the
+current reader document object. It uses the ordinary reader when none exists.
+
+Required methods (colon calls):
+
+- `pages()`: array of visible native document page numbers.
+- `key()`: string that changes on page, crop, zoom, pan, rotation or layout changes.
+- `toPage(x, y)`: screen point to `page, x, y, zoom, angle`; angle is the
+  clockwise document-to-screen rotation in radians; zoom is positive.
+- `toScreen(page, x, y)`: native document point to `x, y, zoom, angle`, or nil
+  for another page. Both mappings must extend beyond the viewport: the top-left
+  of a stroke's bounding box can be just outside it.
+- `snapshot(bb)`: paint the screen-sized background without Ink Away annotations.
+- `repaint()`: request a viewer repaint.
+- `clip()`: content rectangle `{x,y,w,h}` in screen coordinates, excluding chrome.
+
+Optional methods:
+
+- `begin()` / `finish()`: acquire/release annotation resources. `finish` must be
+  safe after the viewer closes.
+- `turn(direction, done)`: navigate, then call `done(surface)` once the new
+  surface and its geometry are ready. The old ink is saved before this call.
+  Navigation can be asynchronous. A drawing canvas stays modal over its viewer.
+- `mapPath(points, to_page, page)`: map a flat x/y path, inserting vertices at
+  layout discontinuities. Needed when an affine transform alone is insufficient.
+- `isAffine()`: false when primitive shape outlines need path mapping.
+- `regions()`: retained affine sub-surfaces with their own `clip`, `key`, point
+  mappings and `pages`. Rendering clips each native operation through each
+  region, keeping text/pictures/fills correct at discontinuities while reading.
+
+The plugin advertises `document_surface_version = 1`. A viewer calls
+`ink:paintDocumentSurface(surface, bb)` after painting its background to display
+saved ink, and `ink:releaseDocumentSurface(surface)` before disposing of the
+surface. The latter saves/closes an active canvas. It must not release a surface
+being handed to `turn`'s completion callback.
+
+The sidecar schema is unchanged. Untouched operations retain their original
+items. Native page coordinates are saved, never screen coordinates or external
+viewer metadata. A surface must belong to a fixed-page document; reflowing text
+uses the existing word anchors in the native reader.
+
+Path strokes and shape outlines can cross discontinuities. In the editable
+canvas, text boxes, pictures and pixel-run fills use their local affine
+transform; their contents are not warped across a removed region. A provider
+should offer an affine/original view when editing those objects across such a
+region. The reading overlay can use `regions()` for exact retained content.
diff --git a/ink/reader/surface.lua b/ink/reader/surface.lua
new file mode 100644
index 0000000..228b26a
--- /dev/null
+++ b/ink/reader/surface.lua
@@ -0,0 +1,80 @@
+-- Optional document surfaces supplied by viewers. No viewer/plugin identities
+-- belong here: see docs/annotation-surfaces.md for the versioned contract.
+local Canvas = require("ink/canvas")
+local Transform = require("ink/transform")
+local UIManager = require("ui/uimanager")
+
+local Surface = {}
+
+function Surface.find(ui)
+    for i = #(UIManager._window_stack or {}), 1, -1 do
+        local widget = UIManager._window_stack[i].widget
+        if widget and type(widget.getAnnotationSurface) == "function" then
+            local surface = widget:getAnnotationSurface()
+            if surface and surface.version == 1 and surface.document == ui.document
+                    and type(surface.pages) == "function" and type(surface.key) == "function"
+                    and type(surface.toPage) == "function" and type(surface.toScreen) == "function"
+                    and type(surface.snapshot) == "function" and type(surface.repaint) == "function"
+                    and type(surface.clip) == "function" then
+                return surface
+            end
+        end
+        if widget and widget.covers_fullscreen and not widget.toast and not widget.invisible then return nil end
+    end
+end
+
+-- An affine part of a surface also describes how widths and non-path objects
+-- turn. Path mapping can additionally cross discontinuities in a document view.
+local function mapped(op, surface, page, to_page)
+    local c = Canvas.cloneOp(nil, op)
+    local x0, y0 = Canvas.opBox(op)
+    if not x0 then return nil end
+    local x, y, scale, angle
+    if to_page then
+        local p, px, py, zoom, rotation = surface:toPage(x0, y0)
+        if not p then return nil end
+        page, x, y, scale, angle = p, px, py, 1 / zoom, -(rotation or 0)
+    else
+        x, y, scale, angle = surface:toScreen(page, x0, y0)
+        if not x then return nil end
+    end
+    Transform.scale(c, x0, y0, scale)
+    Transform.rotate(c, x0, y0, angle or 0)
+    Canvas.translateOp(c, x - x0, y - y0)
+    if surface.mapPath then
+        if op.kind == "ink" then
+            c.pts = surface:mapPath(op.pts, to_page, page)
+        elseif op.kind == "shape" and surface.isAffine and not surface:isAffine() then
+            -- A primitive crossing a discontinuity is a polygon in the other
+            -- coordinate system. Keep it in the existing shape format; no new
+            -- persistent op types or viewer-specific metadata are needed.
+            local outline = require("ink/shapes").outlines(op)[1]
+            if outline then
+                c.pts = surface:mapPath(outline, to_page, page)
+                c.shape, c.angle = "poly", nil
+                c.closed = op.shape ~= "line" and op.shape ~= "curve"
+                    and (op.shape ~= "poly" or op.closed) or false
+            end
+        end
+    end
+    return c, page
+end
+
+function Surface.doc(surface)
+    local doc = { kind = "paging" }
+    function doc:toPage(x, y) return surface:toPage(x, y) end
+    function doc:toScreen(page, x, y) return surface:toScreen(page, x, y) end
+    function doc:anchorOp(op)
+        local c, page = mapped(op, surface, nil, true)
+        if not c then return nil end
+        local x, y = Canvas.opBox(c)
+        return { op = require("ink/reader/place").moved(c, -x, -y), a = { page = page, x = x, y = y } }
+    end
+    function doc:placeOp(item)
+        local op = require("ink/reader/place").moved(item.op, item.a.x, item.a.y)
+        return mapped(op, surface, item.a.page, false)
+    end
+    return doc
+end
+
+return Surface
