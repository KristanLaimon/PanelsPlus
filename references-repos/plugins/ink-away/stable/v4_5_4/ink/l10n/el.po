#: ink/reader/roomtool.lua
msgid "A band across the page, before the paragraph nearest the box's top."
msgstr "Μια λωρίδα σε όλο το πλάτος της σελίδας, πριν από την παράγραφο που είναι πιο κοντά στο πάνω μέρος του πλαισίου."

#: ink/view/document.lua
#: ink/view/library.lua
msgid "A blank page. Hold to start from a picture."
msgstr "Μια κενή σελίδα. Κρατήστε πατημένο για να ξεκινήσετε από μια εικόνα."

#: ink/view/library.lua
msgid "A clip you paste or add to a page is copied into it first, so it stays. Only the clips left in this folder are removed."
msgstr "Ένα απόσπασμα που επικολλάς ή προσθέτεις σε μια σελίδα αντιγράφεται πρώτα εκεί, ώστε να μένει. Αφαιρούνται μόνο τα αποσπάσματα που μένουν σε αυτόν τον φάκελο."

#: ink/guide.lua
msgid "A contents page"
msgstr "Μια σελίδα περιεχομένων"

#: ink/view/layers.lua
#, lua-format
msgid "A drawing can have up to %1 layers."
msgstr "Ένα σχέδιο μπορεί να έχει έως %1 επίπεδα."

#: ink/view/layers.lua
msgid "A drawing with layers keeps at least one. To stop using layers, turn them off in File."
msgstr "Ένα σχέδιο με επίπεδα κρατά τουλάχιστον ένα. Για να σταματήσετε να χρησιμοποιείτε επίπεδα, απενεργοποιήστε τα στο Αρχείο."

#: ink/sync/errors.lua
msgid "A file on this reader could not be read."
msgstr "Δεν ήταν δυνατή η ανάγνωση ενός αρχείου σε αυτή τη συσκευή."

#: ink/sync/errors.lua
msgid "A file on this reader could not be written, so nothing was replaced."
msgstr "Δεν ήταν δυνατή η εγγραφή ενός αρχείου σε αυτή τη συσκευή, οπότε δεν αντικαταστάθηκε τίποτα."

#: ink/sync/errors.lua
msgid "A file used by a notebook is not on this reader and could not be found."
msgstr "Ένα αρχείο που χρησιμοποιεί ένα σημειωματάριο δεν υπάρχει σε αυτή τη συσκευή και δεν βρέθηκε."

#: ink/guide.lua
msgid "A folder's notebooks are tabs beside their pages. Hold a tab to rename, colour or reorder it; hold a page to star, move or copy it."
msgstr "Τα σημειωματάρια ενός φακέλου είναι καρτέλες δίπλα στις σελίδες τους. Κρατήστε πατημένη μια καρτέλα για να τη μετονομάσετε, να τη χρωματίσετε ή να την αναδιατάξετε· κρατήστε πατημένη μια σελίδα για να της βάλετε αστέρι, να τη μετακινήσετε ή να την αντιγράψετε."

#: ink/reader/inkview.lua
msgid "A highlighter stroke over text becomes the reader's own highlight of it, in the pen's colour: in your highlights list, and with the text at any font size. Over empty space it stays ink."
msgstr "Μια γραμμή υπογραμμιστή πάνω σε κείμενο γίνεται η δική σας επισήμανση στο βιβλίο, στο χρώμα του στυλό: στη λίστα επισημάνσεών σας και με το κείμενο σε κάθε μέγεθος γραμματοσειράς. Πάνω σε κενό χώρο μένει μελάνι."

#: ink/guide.lua
msgid "A highlighter stroke over text becomes the reader's own highlight, from the first word it touches to the last. Over empty space it stays ink."
msgstr "Μια γραμμή υπογραμμιστή πάνω σε κείμενο γίνεται η δική σας επισήμανση στο βιβλίο, από την πρώτη λέξη που αγγίζει ως την τελευταία. Πάνω σε κενό χώρο μένει μελάνι."

#: ink/view/sync.lua
msgid "A large part of your notebooks will be removed in the cloud or on this reader. A safety copy is kept on this reader for 30 days."
msgstr "Μεγάλο μέρος των σημειωματαρίων σας θα αφαιρεθεί από το cloud ή από αυτή τη συσκευή. Ένα αντίγραφο ασφαλείας φυλάσσεται σε αυτή τη συσκευή για 30 ημέρες."

#: ink/guide.lua
msgid "A new pen"
msgstr "Ένα νέο στυλό"

#: ink/view/updates.lua
#, lua-format
