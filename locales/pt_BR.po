# Panel-opening gesture picker
# Screen: Open panels with: Long press / Two-finger tap, including their help text.
# Path: Panel viewer > More config... > Open panels with; or top menu > Tools > Panels+ > Open panels with.

msgid "A long press on the page opens the panel under it. Panels+ takes over KOReader's long press on comic pages."
msgstr "Um toque longo na página abre o painel tocado. Nas páginas de quadrinhos, o Panels+ passa a controlar o toque longo do KOReader."

msgid "A tap with two fingers opens the panel under them, and a long press is left to KOReader or other plugins. Needs a multi-touch screen."
msgstr "Um toque com dois dedos abre o painel tocado e deixa o toque longo para o KOReader ou outros plugins. Requer uma tela com suporte a multitoque."

msgid "Long press"
msgstr "Toque longo"

msgid "Open panels with"
msgstr "Abrir painéis com"

msgid "Two-finger tap"
msgstr "Toque com dois dedos"

# More Config: double-page spreads
# Screen: More Config: Rotate spreads / Remove spread fold line and their values.
# Path: Panel viewer > More config... > Rotate spreads / Remove spread fold line.

msgid "Viewer"
msgstr "Visualizador"

msgid "Viewer + reading"
msgstr "Visualizador + leitura"

msgid "Reading"
msgstr "Leitura"

msgid "Remove spread fold line"
msgstr "Remover dobra da página dupla"

